{
  "name": "ssc-railway-typing-platform",
  "version": "1.0.0",
  "description": "Full-stack SSC & Railway Typing Test Engine (TCS iON Simulation + DEST Evaluation)",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "echo Pre-built client assets ready"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongodb": "^7.7.0"
  }
}
